<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Приёмник Apple TV Remote"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Управляйте Android TV напрямую с пульта из Центра управления iPhone / iPad"
            android:textColor="#B0BEC5"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN для сопряжения: 1111"
                    android:textColor="#4CAF50"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="IP-адрес: загрузка..."
                    android:textColor="#ECEFF1"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Статус: инициализация..."
                    android:textColor="#4CAF50"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Служба спецвозможностей: проверка..."
                    android:textColor="#ECEFF1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvMenuBinding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Назначение кнопки Menu: нет (по умолчанию)"
                    android:textColor="#ECEFF1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvInjectionMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ввод кнопок: автоадаптация (аппаратный -> ADB -> спецвозможности)"
                    android:textColor="#81D4FA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDriverStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Проверка каналов: аппаратный[--] | локальный ADB[--] | спецвозможности[--]"
                    android:textColor="#ECEFF1"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Остановить сервер"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btnAccessibility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Настройки спецвозможностей"
                        android:focusable="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnInjectionMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Сменить режим ввода кнопок"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btnMenuBinding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Настроить кнопку Menu"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="#1E1E1E"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Журнал событий"
                    android:textColor="#90CAF9"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Ожидание подключения Apple TV Remote..."
                        android:textColor="#CFD8DC"
                        android:textSize="13sp" />

                </ScrollView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
